#include<stdio.h>
#define N 4
int min(int a,int b)
{
return a<b?a:b;
}
int main()
{
int e[2]={7,9},x[2]={8,6};
int a[2][N]={{4,3,5,2},{5,2,4,3}};
int t[2][N-1]={{1,2,1},{2,1,2}};
int f1[N],f2[N],i,result;
f1[0]=e[0]+a[0][0];
f2[0]=e[1]+a[1][0];
for(i=1;i<N;i++)
{
f1[i]=min(f1[i-1]+a[0][i],f2[i-1]+t[1][i-1]+a[0][i]);
f2[i]=min(f2[i-1]+a[1][i],f1[i-1]+t[0][i-1]+a[1][i]);
}
result=min(f1[N-1]+x[0],f2[N-1]+x[1]);
printf("Minimum Production Time = %d",result);
return 0;
}
