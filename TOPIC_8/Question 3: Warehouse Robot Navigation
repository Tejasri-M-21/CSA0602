def dice_ways(dice, faces, target):
    # dp[i][j] = number of ways to get sum j using i dice
    dp = [[0] * (target + 1) for _ in range(dice + 1)]

    # 0 dice can produce sum 0 in one way
    dp[0][0] = 1

    for i in range(1, dice + 1):
        for total in range(1, target + 1):
            for face in range(1, faces + 1):
                if total >= face:
                    dp[i][total] += dp[i - 1][total - face]

    return dp[dice][target]


# Input
dice = 4
faces = 4
target = 10

# Calculate number of ways
ways = dice_ways(dice, faces, target)

print("Number of Dice =", dice)
print("Faces per Dice =", faces)
print("Target Distance =", target)
print("Number of ways =", ways)
