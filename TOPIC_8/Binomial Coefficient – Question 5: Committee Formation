def binomial_coefficient(n, r):
    if r < 0 or r > n:
        return 0

    # Create DP table
    dp = [[0] * (r + 1) for _ in range(n + 1)]

    for i in range(n + 1):
        dp[i][0] = 1

        for j in range(1, min(i, r) + 1):
            if j == i:
                dp[i][j] = 1
            else:
                dp[i][j] = dp[i - 1][j - 1] + dp[i - 1][j]

    return dp[n][r]


# Input
total_members = 12
committee_size = 5

# Calculate number of committees
committees = binomial_coefficient(total_members, committee_size)

print("Total Members =", total_members)
print("Committee Size =", committee_size)
print("Number of Committees =", committees)
