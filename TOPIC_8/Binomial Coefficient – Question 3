def binomial_coefficient(n, r):
    if r < 0 or r > n:
        return 0

    # Use the smaller value of r
    r = min(r, n - r)

    result = 1

    for i in range(1, r + 1):
        result = result * (n - i + 1) // i

    return result


# Input
n = 8
r = 3

# Calculate Binomial Coefficient
result = binomial_coefficient(n, r)

print("n =", n)
print("r =", r)
print("C(8,3) =", result)
