def network_delay_time(times, n, k):
    INF = float('inf')

    # Initialize distances
    dist = [INF] * (n + 1)
    dist[k] = 0

    # Bellman-Ford Algorithm
    for _ in range(n - 1):
        updated = False

        for u, v, time in times:
            if dist[u] != INF and dist[u] + time < dist[v]:
                dist[v] = dist[u] + time
                updated = True

        if not updated:
            break

    # Check if all nodes are reachable
    for i in range(1, n + 1):
        if dist[i] == INF:
            return -1

    # Maximum shortest distance is the time for all nodes
    return max(dist[1:])


# Example 1
times = [
    [2, 1, 1],
    [2, 3, 1],
    [3, 4, 1]
]
n = 4
k = 2

print("Example 1 Output:", network_delay_time(times, n, k))


# Example 2
times = [
    [1, 2, 1]
]
n = 2
k = 2

print("Example 2 Output:", network_delay_time(times, n, k))
