INF = float('inf')

def graph_diameter(graph):
    n = len(graph)

    # Copy the graph into distance matrix
    dist = [row[:] for row in graph]

    # Floyd-Warshall Algorithm
    for k in range(n):
        for i in range(n):
            for j in range(n):
                dist[i][j] = min(
                    dist[i][j],
                    dist[i][k] + dist[k][j]
                )

    # Find the maximum shortest-path distance
    diameter = 0

    for i in range(n):
        for j in range(n):
            if dist[i][j] != INF:
                diameter = max(diameter, dist[i][j])

    return diameter


# Example 1
graph1 = [
    [0, 2, INF],
    [2, 0, 4],
    [INF, 4, 0]
]

print("Example 1 Output:", graph_diameter(graph1))


# Example 2
graph2 = [
    [0, 1, 5],
    [1, 0, 2],
    [5, 2, 0]
]

print("Example 2 Output:", graph_diameter(graph2))
