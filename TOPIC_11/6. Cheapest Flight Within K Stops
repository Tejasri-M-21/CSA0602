def cheapest_flight(n, flights, src, dst, K):
    INF = float('inf')

    # Distance from source to every city
    dist = [INF] * n
    dist[src] = 0

    # At most K stops means at most K + 1 edges
    for _ in range(K + 1):
        temp = dist[:]

        for u, v, cost in flights:
            if dist[u] != INF:
                temp[v] = min(
                    temp[v],
                    dist[u] + cost
                )

        dist = temp

    if dist[dst] == INF:
        return -1

    return dist[dst]


# Example 1
n = 4
flights = [
    [0, 1, 100],
    [1, 2, 100],
    [2, 3, 100],
    [0, 3, 500]
]
src = 0
dst = 3
K = 1

print("Example 1 Output:", cheapest_flight(n, flights, src, dst, K))


