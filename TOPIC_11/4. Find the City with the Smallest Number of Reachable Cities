def find_city(n, edges, threshold):
    INF = float('inf')

    # Create distance matrix
    dist = [[INF] * n for _ in range(n)]

    for i in range(n):
        dist[i][i] = 0

    # Add edges
    for u, v, weight in edges:
        dist[u][v] = weight
        dist[v][u] = weight

    # Floyd-Warshall Algorithm
    for k in range(n):
        for i in range(n):
            for j in range(n):
                dist[i][j] = min(
                    dist[i][j],
                    dist[i][k] + dist[k][j]
                )

    # Find city with minimum reachable cities
    min_count = n
    result = -1

    for i in range(n):
        count = 0

        for j in range(n):
            if i != j and dist[i][j] <= threshold:
                count += 1

        # Use larger city number in case of a tie
        if count <= min_count:
            min_count = count
            result = i

    return result


# Example 1
n = 4
edges = [
    [0, 1, 3],
    [1, 2, 1],
    [2, 3, 4],
    [0, 3, 7]
]
threshold = 4

print("Example 1 Output:", find_city(n, edges, threshold))


