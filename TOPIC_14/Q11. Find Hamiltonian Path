def is_safe(vertex, graph, path):
    # Check if vertex is connected to the previous vertex
    if graph[path[-1]][vertex] == 0:
        return False

    # Check if vertex is already visited
    if vertex in path:
        return False

    return True


def hamiltonian_path_util(graph, path, n):
    # All vertices are included
    if len(path) == n:
        return True

    # Try every vertex
    for vertex in range(n):
        if is_safe(vertex, graph, path):
            path.append(vertex)

            if hamiltonian_path_util(graph, path, n):
                return True

            # Backtrack
            path.pop()

    return False


def find_hamiltonian_path(graph, n):
    # Try every vertex as a starting vertex
    for start in range(n):
        path = [start]

        if hamiltonian_path_util(graph, path, n):
            return path

    return None


# Input
n = 5

edges = [
    (0, 1),
    (1, 2),
    (2, 3),
    (3, 4)
]

# Create adjacency matrix
graph = [[0] * n for _ in range(n)]

for u, v in edges:
    graph[u][v] = 1
    graph[v][u] = 1

# Find Hamiltonian Path
path = find_hamiltonian_path(graph, n)

if path:
    print("Hamiltonian Path:")
    print(" → ".join(map(str, path)))
else:
    print("No Hamiltonian Path Exists.")
