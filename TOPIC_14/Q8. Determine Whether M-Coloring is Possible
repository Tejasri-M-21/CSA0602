def is_safe(graph, colors, vertex, color, n):
    # Check all adjacent vertices
    for i in range(n):
        if graph[vertex][i] == 1 and colors[i] == color:
            return False

    return True


def can_color(graph, colors, vertex, n, m):
    # All vertices are successfully colored
    if vertex == n:
        return True

    # Try each color
    for color in range(1, m + 1):
        if is_safe(graph, colors, vertex, color, n):
            colors[vertex] = color

            # Try coloring the next vertex
            if can_color(graph, colors, vertex + 1, n, m):
                return True

            # Backtrack
            colors[vertex] = 0

    return False


# Input
n = 5
m = 3

edges = [
    (0, 1),
    (0, 2),
    (1, 2),
    (1, 3),
    (2, 4)
]

# Create adjacency matrix
graph = [[0 for _ in range(n)] for _ in range(n)]

for u, v in edges:
    graph[u][v] = 1
    graph[v][u] = 1

colors = [0] * n

# Check whether M-coloring is possible
if can_color(graph, colors, 0, n, m):
    print("Graph can be colored using 3 colors.")
else:
    print("Graph cannot be colored using 3 colors.")
