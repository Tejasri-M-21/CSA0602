def is_safe(graph, colors, vertex, color, n):
    for i in range(n):
        if graph[vertex][i] == 1 and colors[i] == color:
            return False
    return True


def can_color(graph, colors, vertex, n, m):
    if vertex == n:
        return True

    for color in range(1, m + 1):
        if is_safe(graph, colors, vertex, color, n):
            colors[vertex] = color

            if can_color(graph, colors, vertex + 1, n, m):
                return True

            colors[vertex] = 0

    return False


def find_chromatic_number(graph, n):
    # Try using 1, 2, 3, ... colors
    for m in range(1, n + 1):
        colors = [0] * n

        if can_color(graph, colors, 0, n, m):
            return m, colors

    return n, colors


# Input
n = 4

edges = [
    (0, 1), (0, 2), (0, 3),
    (1, 2), (1, 3),
    (2, 3)
]

# Create adjacency matrix
graph = [[0] * n for _ in range(n)]

for u, v in edges:
    graph[u][v] = 1
    graph[v][u] = 1

# Find minimum number of colors
minimum_colors, coloring = find_chromatic_number(graph, n)

print("Minimum Colors Required =", minimum_colors)

print("\nColor Assignment:")
for i in range(n):
    print("Vertex", i, "-> Color", coloring[i])
