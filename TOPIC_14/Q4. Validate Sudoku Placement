def is_safe(board, row, col, num):
    # Check row
    for j in range(9):
        if board[row][j] == num:
            return False

    # Check column
    for i in range(9):
        if board[i][col] == num:
            return False

    # Find the 3x3 subgrid
    start_row = (row // 3) * 3
    start_col = (col // 3) * 3

    # Check 3x3 subgrid
    for i in range(start_row, start_row + 3):
        for j in range(start_col, start_col + 3):
            if board[i][j] == num:
                return False

    return True


# Sudoku board
board = [
