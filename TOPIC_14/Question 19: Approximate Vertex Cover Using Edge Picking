def approximate_vertex_cover(vertices, edges):
    cover = set()

    # Keep track of uncovered edges
    uncovered_edges = edges.copy()

    while uncovered_edges:
        # Pick the first uncovered edge
        u, v = uncovered_edges[0]

        # Add both endpoints to the cover
        cover.add(u)
        cover.add(v)

        # Remove all edges covered by u or v
        uncovered_edges = [
            (a, b) for a, b in uncovered_edges
            if a != u and a != v and b != u and b != v
        ]

    return cover


# Input
vertices = 6

edges = [
    (0, 1),
    (0, 2),
    (1, 3),
    (2, 4),
    (4, 5)
]

# Find approximate vertex cover
cover = approximate_vertex_cover(vertices, edges)

# Display result
print("Approximate Vertex Cover:")
print("{" + ",".join(map(str, sorted(cover))) + "}")

print("Cover Size =", len(cover))
