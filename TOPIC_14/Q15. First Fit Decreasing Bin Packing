def first_fit_decreasing(items, capacity):
    # Sort items in decreasing order
    items = sorted(items, reverse=True)

    bins = []

    # Place each item into the first bin where it fits
    for item in items:
        placed = False

        for bin in bins:
            if sum(bin) + item <= capacity:
                bin.append(item)
                placed = True
                break

        # If it does not fit in any existing bin, create a new bin
        if not placed:
            bins.append([item])

    return items, bins


# Input
capacity = 10
items = [2, 5, 4, 7, 1, 3, 8]

# Apply First Fit Decreasing
sorted_items, bins = first_fit_decreasing(items, capacity)

# Output
print("Sorted Items:")
print(sorted_items)

for i, bin in enumerate(bins, start=1):
    print("Bin", i, ":", " ".join(map(str, bin)))

print("Total Bins Used =", len(bins))
