from itertools import combinations


def is_vertex_cover(vertices, edges, cover):
    """Check whether all edges are covered."""
    for u, v in edges:
        if u not in cover and v not in cover:
            return False
    return True


def exact_vertex_cover(vertices, edges):
    """Find the minimum vertex cover by exhaustive search."""
    for size in range(vertices + 1):
        for combination in combinations(range(vertices), size):
            cover = set(combination)

            if is_vertex_cover(vertices, edges, cover):
                return cover

    return set()


def approximate_vertex_cover(vertices, edges):
    """
    Greedy approximation:
    repeatedly select the vertex with the highest
    degree among the remaining uncovered edges.
    """
    remaining_edges = edges.copy()
    cover = set()

    while remaining_edges:
        degree = [0] * vertices

        for u, v in remaining_edges:
            degree[u] += 1
            degree[v] += 1

        # Select highest-degree vertex.
        # In a tie, select the larger vertex number.
        selected = max(range(vertices), key=lambda x: (degree[x], x))

        cover.add(selected)

        # Remove all edges covered by selected vertex
        remaining_edges = [
            (u, v)
            for u, v in remaining_edges
            if u != selected and v != selected
        ]

    return cover


# Input
vertices = 6

edges = [
    (0, 1),
    (0, 2),
    (1, 3),
    (2, 4),
    (3, 5)
]

# Exact Vertex Cover
exact_cover = exact_vertex_cover(vertices, edges)

# Approximate Vertex Cover
approx_cover = approximate_vertex_cover(vertices, edges)

# Display results
print("Exact Vertex Cover:", sorted(exact_cover))
print("Exact Vertex Cover Size =", len(exact_cover))

print("Approximate Vertex Cover:", sorted(approx_cover))
print("Approximate Vertex Cover Size =", len(approx_cover))

# Approximation ratio
ratio = len(approx_cover) / len(exact_cover)

print("Approximation Ratio = %.2f" % ratio)
