def best_fit_bin_packing(items, capacity):
    bins = []

    for item in items:
        best_bin = -1
        min_remaining = capacity + 1

        # Find the bin with the least remaining space
        # that can still accommodate the item
        for i in range(len(bins)):
            remaining = capacity - sum(bins[i])

            if remaining >= item and remaining - item < min_remaining:
                min_remaining = remaining - item
                best_bin = i

        # If no suitable bin is found, create a new bin
        if best_bin == -1:
            bins.append([item])
        else:
            bins[best_bin].append(item)

    return bins


# Input
capacity = 10
items = [2, 5, 4, 7, 1, 3, 8]

# Apply Best Fit
bins = best_fit_bin_packing(items, capacity)

# Display result
for i, bin_items in enumerate(bins, start=1):
    print(f"Bin {i}:", *bin_items)

print("Total Bins Used =", len(bins))
