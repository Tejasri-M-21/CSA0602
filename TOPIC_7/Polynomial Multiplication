# Question 5: Polynomial Multiplication
def multiply_naive(a,b):
    c=[0]*(len(a)+len(b)-1)
    for i in range(len(a)):
        for j in range(len(b)):
            c[i+j]+=a[i]*b[j]
    return c

def karatsuba_poly(a,b):
    if len(a)==1 or len(b)==1:
        return multiply_naive(a,b)

    n=max(len(a),len(b))
    m=n//2

    a=a+[0]*(n-len(a))
    b=b+[0]*(n-len(b))

    a0,a1=a[:m],a[m:]
    b0,b1=b[:m],b[m:]

    z0=karatsuba_poly(a0,b0)
    z2=karatsuba_poly(a1,b1)
    z1=karatsuba_poly([a0[i]+a1[i] for i in range(m)],
                      [b0[i]+b1[i] for i in range(m)])

    z1=[z1[i]-z0[i]-z2[i] for i in range(len(z1))]
    result=[0]*(2*n-1)

    for i,v in enumerate(z0): result[i]+=v
    for i,v in enumerate(z1): result[i+m]+=v
    for i,v in enumerate(z2): result[i+2*m]+=v

    return result

print(karatsuba_poly([1,2],[3,4]))
