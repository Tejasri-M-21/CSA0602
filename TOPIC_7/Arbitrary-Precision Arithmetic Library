# Question 2: Arbitrary-Precision Arithmetic Library
def schoolbook(x,y):
    return x*y

def karatsuba(x,y):
    if x < 10 or y < 10:
        return x*y

    n=max(len(str(x)),len(str(y)))
    m=n//2
    p=10**m
    a,b=divmod(x,p)
    c,d=divmod(y,p)

    z2=karatsuba(a,c)
    z0=karatsuba(b,d)
    z1=karatsuba(a+b,c+d)-z2-z0

    return z2*p*p+z1*p+z0

for n in [2,4,8,16,32]:
    x=int('7'*n)
    y=int('3'*n)
    print(n, schoolbook(x,y), karatsuba(x,y))
