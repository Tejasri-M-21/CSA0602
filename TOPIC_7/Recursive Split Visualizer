# Question 4: Recursive Split Visualizer
def karatsuba_traced(x,y,trace,depth=0):
    trace.append((depth,x,y))

    if x<10 or y<10:
        return x*y

    n=max(len(str(x)),len(str(y)))
    m=n//2
    p=10**m
    a,b=divmod(x,p)
    c,d=divmod(y,p)

    z2=karatsuba_traced(a,c,trace,depth+1)
    z0=karatsuba_traced(b,d,trace,depth+1)
    z1=karatsuba_traced(a+b,c+d,trace,depth+1)-z2-z0

    return z2*p*p+z1*p+z0

trace=[]
result=karatsuba_traced(1234,56,trace)
print(result)
print(trace)
