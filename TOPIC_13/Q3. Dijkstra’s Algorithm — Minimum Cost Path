import heapq

def dijkstra(n, edges, source, destination):
    # Create adjacency list
    graph = [[] for _ in range(n)]

    for u, v, weight in edges:
        graph[u].append((v, weight))

    # Distance array
    distance = [float('inf')] * n

    # Parent array for path reconstruction
    parent = [-1] * n

    distance[source] = 0

    # Priority queue
    pq = [(0, source)]

    while pq:
        current_distance, u = heapq.heappop(pq)

        # Ignore outdated entries
        if current_distance > distance[u]:
            continue

        # Destination reached
        if u == destination:
            break

        # Relax adjacent vertices
        for v, weight in graph[u]:
            new_distance = current_distance + weight

            if new_distance < distance[v]:
                distance[v] = new_distance
                parent[v] = u
                heapq.heappush(pq, (new_distance, v))

    # Reconstruct shortest path
    path = []
    current = destination

    while current != -1:
        path.append(current)
        current = parent[current]

    path.reverse()

    return distance[destination], path


# Input
n = 6
source = 0
destination = 5

edges = [
    (0, 1, 7),
    (0, 2, 9),
    (0, 5, 14),
    (1, 2, 10),
    (1, 3, 15),
    (2, 3, 11),
    (2, 5, 2),
    (3, 4, 6),
    (4, 5, 9)
]

# Find shortest path
shortest_distance, path = dijkstra(
    n, edges, source, destination
)

# Display result
print("Shortest distance from 0 to 5:", shortest_distance)
print("Path:", " → ".join(map(str, path)))
