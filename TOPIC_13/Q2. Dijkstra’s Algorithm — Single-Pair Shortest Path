import heapq

def dijkstra(n, edges, source, destination):
    # Create adjacency list
    graph = [[] for _ in range(n)]

    for u, v, w in edges:
        graph[u].append((v, w))

    # Distance and parent arrays
    dist = [float('inf')] * n
    parent = [-1] * n

    dist[source] = 0

    # Priority queue
    pq = [(0, source)]

    while pq:
        current_dist, u = heapq.heappop(pq)

        if current_dist > dist[u]:
            continue

        # Stop when destination is reached
        if u == destination:
            break

        for v, weight in graph[u]:
            new_dist = current_dist + weight

            if new_dist < dist[v]:
                dist[v] = new_dist
                parent[v] = u
                heapq.heappush(pq, (new_dist, v))

    # Reconstruct path
    path = []
    current = destination

    while current != -1:
        path.append(current)
        current = parent[current]

    path.reverse()

    return dist[destination], path


# Input
n = 5
source = 0
destination = 4

edges = [
    (0, 1, 10),
    (0, 2, 3),
    (1, 3, 2),
    (2, 1, 4),
    (2, 3, 8),
    (2, 4, 2),
    (3, 4, 5)
]

# Run Dijkstra
distance, path = dijkstra(n, edges, source, destination)

print("Shortest distance:", distance)
print("Path:", " → ".join(map(str, path)))
