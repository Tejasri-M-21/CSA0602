# Q5. MST Sensitivity Analysis

def find(parent, x):
    if parent[x] != x:
        parent[x] = find(parent, parent[x])
    return parent[x]


def union(parent, rank, x, y):
    root_x = find(parent, x)
    root_y = find(parent, y)

    if root_x == root_y:
        return False

    if rank[root_x] < rank[root_y]:
        parent[root_x] = root_y
    elif rank[root_x] > rank[root_y]:
        parent[root_y] = root_x
    else:
        parent[root_y] = root_x
        rank[root_x] += 1

    return True


def kruskal(n, edges):
    parent = list(range(n))
    rank = [0] * n

    mst = []
    non_mst = []
    total_weight = 0

    # Sort edges by weight
    sorted_edges = sorted(edges, key=lambda x: (x[2], x[0], x[1]))

    for u, v, w in sorted_edges:
        if union(parent, rank, u, v):
            mst.append((u, v, w))
            total_weight += w
        else:
            non_mst.append((u, v, w))

    return mst, non_mst, total_weight


def find_path_edges(n, mst, start, end):
    """Find the edges on the MST path between start and end."""
    graph = [[] for _ in range(n)]

    for u, v, w in mst:
        graph[u].append((v, w, (u, v, w)))
        graph[v].append((u, w, (u, v, w)))

    visited = [False] * n
    path = []

    def dfs(node):
        if node == end:
            return True

        visited[node] = True

        for neighbor, weight, edge in graph[node]:
            if not visited[neighbor]:
                path.append(edge)

                if dfs(neighbor):
                    return True

                path.pop()

        return False

    dfs(start)
    return path


# Input
n = 5

edges = [
    (0, 1, 1),
    (0, 2, 5),
    (1, 2, 3),
    (1, 3, 4),
    (2, 3, 2),
    (2, 4, 6),
    (3, 4, 7),
    (0, 4, 9)
]

# Find MST
mst, non_mst, mst_weight = kruskal(n, edges)

print("MST edges:", mst)
print("MST weight:", mst_weight)

print("Non-MST edges:", non_mst)

# Find the best swap
best_new_weight = float("inf")
best_add = None
best_remove = None

for u, v, w in non_mst:
    # Find MST path between u and v
    path = find_path_edges(n, mst, u, v)

    # The most expensive edge on that path
    remove_edge = max(path, key=lambda x: x[2])

    # New MST weight after replacing that edge
    new_weight = mst_weight + w - remove_edge[2]

    if new_weight < best_new_weight:
        best_new_weight = new_weight
        best_add = (u, v, w)
        best_remove = remove_edge

print("Best swap: add", best_add, "remove", best_remove)
print("New MST weight:", best_new_weight)
