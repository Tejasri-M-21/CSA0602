import math

def prim_with_key(n, start, edges):
    # Create adjacency list
    graph = [[] for _ in range(n)]

    for u, v, w in edges:
        graph[u].append((v, w))
        graph[v].append((u, w))

    # Initialize key, parent and visited arrays
    key = [math.inf] * n
    parent = [-1] * n
    visited = [False] * n

    key[start] = 0

    mst = []
    total_weight = 0

    print("Initial key[]:", key)

    for step in range(n):

        # Find unvisited vertex with minimum key
        min_key = math.inf
        u = -1

        for v in range(n):
            if not visited[v] and key[v] < min_key:
                min_key = key[v]
                u = v

        if u == -1:
            break

        # Pick vertex
        visited[u] = True

        # Add edge to MST
        if parent[u] != -1:
            mst.append((u, parent[u], key[u]))
            total_weight += key[u]

        # Update key values of adjacent vertices
        for v, weight in graph[u]:
            if not visited[v] and weight < key[v]:
                key[v] = weight
                parent[v] = u

        print(f"After picking {u}: key[] =", key)

    print("MST edges:", mst)
    print("weight:", total_weight)


# Input
n = 5
start = 2

edges = [
    (0, 1, 2),
    (0, 3, 6),
    (1, 2, 3),
    (1, 3, 8),
    (1, 4, 5),
    (2, 4, 7),
    (3, 4, 9)
]

prim_with_key(n, start, edges)
