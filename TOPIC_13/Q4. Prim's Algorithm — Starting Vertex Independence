import heapq


def prim(n, start, edges):
    # Create adjacency list
    graph = [[] for _ in range(n)]

    for u, v, w in edges:
        graph[u].append((w, v))
        graph[v].append((w, u))

    visited = [False] * n
    min_heap = [(0, start, -1)]

    mst = []
    total_weight = 0

    while min_heap and len(mst) < n - 1:
        weight, u, parent = heapq.heappop(min_heap)

        if visited[u]:
            continue

        visited[u] = True

        if parent != -1:
            mst.append((parent, u, weight))
            total_weight += weight

        # Add all edges from current vertex
        for w, v in graph[u]:
            if not visited[v]:
                heapq.heappush(min_heap, (w, v, u))

    return mst, total_weight


# Input
n = 4

edges = [
    (0, 1, 3),
    (0, 3, 7),
    (1, 2, 2),
    (1, 3, 5),
    (2, 3, 1)
]

# Run Prim's from vertices 0, 1 and 2
for start in [0, 1, 2]:
    mst, weight = prim(n, start, edges)

    print(f"MST weight (start={start}): {weight}")
    print("Edges:", mst)
    print()


# Check whether all weights are the same
weights = []

for start in [0, 1, 2]:
    _, weight = prim(n, start, edges)
    weights.append(weight)

if len(set(weights)) == 1:
    print("Yes - same total weight 6 regardless of start vertex.")
else:
    print("No - different starting vertices produce different MST weights.")
