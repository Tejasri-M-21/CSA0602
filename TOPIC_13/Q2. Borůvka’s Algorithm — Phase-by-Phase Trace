# Boruvka's Algorithm - Phase-by-Phase Trace

n = 5

edges = [
    (0, 1, 2),
    (0, 3, 6),
    (1, 2, 3),
    (1, 3, 8),
    (1, 4, 5),
    (2, 4, 7),
    (3, 4, 9)
]

parent = list(range(n))


def find(x):
    if parent[x] != x:
        parent[x] = find(parent[x])
    return parent[x]


def union(a, b):
    root_a = find(a)
    root_b = find(b)

    if root_a != root_b:
        parent[root_b] = root_a
        return True

    return False


mst = []
mst_weight = 0
phase = 1

while len(mst) < n - 1:

    cheapest = [-1] * n

    # Find the cheapest outgoing edge for each component
    for i, (u, v, w) in enumerate(edges):
        set_u = find(u)
        set_v = find(v)

        if set_u == set_v:
            continue

        if cheapest[set_u] == -1 or edges[cheapest[set_u]][2] > w:
            cheapest[set_u] = i

        if cheapest[set_v] == -1 or edges[cheapest[set_v]][2] > w:
            cheapest[set_v] = i

    phase_edges = []

    # Add selected cheapest edges
    for i in range(n):
        if cheapest[i] != -1:
            u, v, w = edges[cheapest[i]]

            if union(u, v):
                mst.append((u, v, w))
                phase_edges.append((u, v, w))
                mst_weight += w

    print(f"Phase {phase} edges added:", phase_edges)

    # Check whether all vertices are connected
    if len(mst) == n - 1:
        print("All vertices merged -> done!")
        break

    phase += 1


print("\nNumber of phases:", phase)
print("MST:", mst)
print("MST weight:", mst_weight)
