import heapq

def dijkstra(n, edges, source, destination):
    # Create an undirected adjacency list
    graph = [[] for _ in range(n)]

    for u, v, weight in edges:
        graph[u].append((v, weight))
        graph[v].append((u, weight))

    # Distance array
    distance = [float('inf')] * n

    # Parent array for path reconstruction
    parent = [-1] * n

    distance[source] = 0

    # Priority queue
    pq = [(0, source)]

    while pq:
        current_distance, u = heapq.heappop(pq)

        # Ignore outdated entries
        if current_distance > distance[u]:
            continue

        for v, weight in graph[u]:
            new_distance = current_distance + weight

            if new_distance < distance[v]:
                distance[v] = new_distance
                parent[v] = u
                heapq.heappush(pq, (new_distance, v))

    # Check reachability
    if distance[destination] == float('inf'):
        return None, None

    # Reconstruct path
    path = []
    current = destination

    while current != -1:
        path.append(current)
        current = parent[current]

    path.reverse()

    return distance[destination], path


# Input
n = 5
source = 0
destination = 3

edges = [
    (0, 1, 5),
    (1, 2, 3),
    (2, 4, 1),
    (3, 4, 2),
    (0, 4, 10)
]

# Find shortest path
distance, path = dijkstra(n, edges, source, destination)

# Display result
if distance is None:
    print("Node 3 is not reachable from node 0.")
else:
    print("Node 3 is reachable.")
    print("Shortest distance from 0 to 3:", distance)
    print("Path:", " → ".join(map(str, path)))
