import heapq

def prim(n, start, edges):
    # Create adjacency list
    graph = [[] for _ in range(n)]

    for u, v, w in edges:
        graph[u].append((w, v))
        graph[v].append((w, u))

    visited = [False] * n
    min_heap = [(0, start, -1)]

    mst = []
    total_weight = 0
    step = 1

    while min_heap and len(mst) < n - 1:
        weight, vertex, parent = heapq.heappop(min_heap)

        if visited[vertex]:
            continue

        visited[vertex] = True

        # Add edge to MST
        if parent != -1:
            mst.append((parent, vertex, weight))
            total_weight += weight
            print(f"Step {step}: Add ({parent},{vertex},{weight})")
            step += 1

        # Add neighboring edges
        for edge_weight, neighbor in graph[vertex]:
            if not visited[neighbor]:
                heapq.heappush(
                    min_heap,
                    (edge_weight, neighbor, vertex)
                )

    print("MST edges:", mst)
    print("Total weight:", total_weight)


# Input
n = 4
start = 0

edges = [
    (0, 1, 10),
    (0, 2, 6),
    (0, 3, 5),
    (1, 3, 15),
    (2, 3, 4)
]

prim(n, start, edges)
