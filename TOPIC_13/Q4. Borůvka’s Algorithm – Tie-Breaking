def boruvka(n, edges):
    parent = list(range(n))
    rank = [0] * n

    def find(x):
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]

    def union(a, b):
        ra = find(a)
        rb = find(b)

        if ra == rb:
            return False

        if rank[ra] < rank[rb]:
            parent[ra] = rb
        elif rank[ra] > rank[rb]:
            parent[rb] = ra
        else:
            parent[rb] = ra
            rank[ra] += 1

        return True

    mst = []
    mst_weight = 0
    phase = 1

    while len(mst) < n - 1:
        cheapest = [-1] * n

        # Find the cheapest outgoing edge for each component.
        # Since we scan in input order, the first edge is kept
        # when two edges have the same weight.
        for i, (u, v, w) in enumerate(edges):
            cu = find(u)
            cv = find(v)

            if cu == cv:
                continue

            if cheapest[cu] == -1 or w < edges[cheapest[cu]][2]:
                cheapest[cu] = i

            if cheapest[cv] == -1 or w < edges[cheapest[cv]][2]:
                cheapest[cv] = i

        print(f"Phase {phase}:")

        for comp in range(n):
            if find(comp) == comp and cheapest[comp] != -1:
                u, v, w = edges[cheapest[comp]]
                print(f"{{{comp}}}: cheapest = ({u},{v},{w})")

        added_this_phase = []

        # Add selected edges
        for i in cheapest:
            if i != -1:
                u, v, w = edges[i]

                if union(u, v):
                    mst.append((u, v, w))
                    mst_weight += w
                    added_this_phase.append((u, v, w))

        print("Edges added:", added_this_phase)
        phase += 1

    print("\nMST:", mst)
    print("MST weight:", mst_weight)


# Input
n = 4
edges = [
    (0, 1, 5),
    (0, 2, 5),
    (1, 2, 3),
    (1, 3, 4),
    (2, 3, 4),
    (0, 3, 8)
]

boruvka(n, edges)
