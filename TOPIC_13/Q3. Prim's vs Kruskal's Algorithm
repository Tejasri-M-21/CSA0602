import heapq


# ---------------- PRIM'S ALGORITHM ----------------

def prim(n, start, edges):
    graph = [[] for _ in range(n)]

    for u, v, w in edges:
        graph[u].append((w, v))
        graph[v].append((w, u))

    visited = [False] * n
    min_heap = [(0, start, -1)]

    mst = []
    total_weight = 0

    while min_heap and len(mst) < n - 1:
        weight, u, parent = heapq.heappop(min_heap)

        if visited[u]:
            continue

        visited[u] = True

        if parent != -1:
            mst.append((parent, u, weight))
            total_weight += weight

        for w, v in graph[u]:
            if not visited[v]:
                heapq.heappush(min_heap, (w, v, u))

    return mst, total_weight


# ---------------- KRUSKAL'S ALGORITHM ----------------

def find(parent, x):
    if parent[x] != x:
        parent[x] = find(parent, parent[x])
    return parent[x]


def union(parent, rank, x, y):
    root_x = find(parent, x)
    root_y = find(parent, y)

    if root_x == root_y:
        return False

    if rank[root_x] < rank[root_y]:
        parent[root_x] = root_y
    elif rank[root_x] > rank[root_y]:
        parent[root_y] = root_x
    else:
        parent[root_y] = root_x
        rank[root_x] += 1

    return True


def kruskal(n, edges):
    parent = list(range(n))
    rank = [0] * n

    mst = []
    total_weight = 0

    # Sort by weight
    sorted_edges = sorted(edges, key=lambda x: (x[2], x[0], x[1]))

    for u, v, w in sorted_edges:
        if union(parent, rank, u, v):
            mst.append((u, v, w))
            total_weight += w

            if len(mst) == n - 1:
                break

    return mst, total_weight


# ---------------- INPUT ----------------

n = 6
start = 0

edges = [
    (0, 1, 4),
    (0, 2, 3),
    (1, 2, 1),
    (1, 3, 2),
    (2, 3, 4),
    (3, 4, 2),
    (4, 5, 6),
    (3, 5, 5)
]


# Run Prim's
prim_mst, prim_weight = prim(n, start, edges)

# Run Kruskal's
kruskal_mst, kruskal_weight = kruskal(n, edges)


# ---------------- OUTPUT ----------------

print("Prim's MST:", prim_mst)
print("weight:", prim_weight)

print("Kruskal's MST:", kruskal_mst)
print("weight:", kruskal_weight)


# Compare edge sets
prim_set = {frozenset((u, v)) for u, v, w in prim_mst}
kruskal_set = {frozenset((u, v)) for u, v, w in kruskal_mst}

if prim_set == kruskal_set:
    print("Edge sets are identical.")
    print("Same total weight, same edges - different insertion order.")
else:
    print("Edge sets are different.")
