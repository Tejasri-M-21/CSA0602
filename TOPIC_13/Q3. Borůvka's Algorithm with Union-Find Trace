# Boruvka's Algorithm with Union-Find Trace

n = 6

edges = [
    (0, 1, 4),
    (0, 2, 3),
    (1, 2, 1),
    (1, 3, 2),
    (2, 3, 4),
    (3, 4, 2),
    (4, 5, 6),
    (3, 5, 5),
    (0, 5, 9)
]

# Initially, every vertex is its own component
parent = list(range(n))


def find(x):
    if parent[x] != x:
        parent[x] = find(parent[x])
    return parent[x]


def union(a, b):
    root_a = find(a)
    root_b = find(b)

    if root_a != root_b:
        parent[root_b] = root_a
        return True

    return False


mst = []
mst_weight = 0
phase = 1

while len(mst) < n - 1:

    cheapest = [-1] * n

    # Find cheapest edge for every component
    for i, (u, v, w) in enumerate(edges):

        root_u = find(u)
        root_v = find(v)

        if root_u == root_v:
            continue

        if cheapest[root_u] == -1 or edges[cheapest[root_u]][2] > w:
            cheapest[root_u] = i

        if cheapest[root_v] == -1 or edges[cheapest[root_v]][2] > w:
            cheapest[root_v] = i

    print(f"Phase {phase} cheapest per component:")

    for i in range(n):
        if cheapest[i] != -1:
            u, v, w = edges[cheapest[i]]
            print(f"Component {{{i}}} -> ({u},{v},{w})")

    phase_edges = []

    # Add cheapest edges
    for i in range(n):
        if cheapest[i] != -1:

            u, v, w = edges[cheapest[i]]

            if union(u, v):
                mst.append((u, v, w))
                phase_edges.append((u, v, w))
                mst_weight += w

    print("Edges added:", phase_edges)

    # Display Union-Find parent array
    print("Parent array after phase", phase, ":", parent)

    # Display components
    components = {}

    for i in range(n):
        root = find(i)

        if root not in components:
            components[root] = []

        components[root].append(i)

    print("Components after phase", phase, ":", list(components.values()))
    print()

    phase += 1


print("MST:", mst)
print("MST weight:", mst_weight)
