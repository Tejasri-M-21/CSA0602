//Travelling Salesman Problem using Exhaustive Search
#include <stdio.h>
#include <math.h>
#include <float.h>
typedef struct {
    double x,y;
} Point;
double distance(Point a,Point b) {
    return sqrt((a.x-b.x)*(a.x-b.x)+(a.y-b.y)*(a.y-b.y));
}
void swap(int *a,int *b) {
    int t=*a;
    *a=*b;
    *b=t;
}
void tsp(Point p[],int n,int level,int path[],int used[],double cost,double *min,int best[]) {
    if(level==n) {
        double total=cost+distance(p[path[n-1]],p[path[0]]);
        if(total<*min) {
            *min=total;
            for(int i=0;i<n;i++) best[i]=path[i];
        }
        return;
    }
    for(int i=1;i<n;i++) {
        if(!used[i]) {
            used[i]=1;
            path[level]=i;
            tsp(p,n,level+1,path,used,cost+distance(p[path[level-1]],p[i]),min,best);
            used[i]=0;
        }
    }
}
void solve(Point p[],int n) {
    int path[10],used[10]={0},best[10];
    double min=DBL_MAX;
    path[0]=0;
    used[0]=1;
    tsp(p,n,1,path,used,0,&min,best);
    printf("Shortest Distance: %.15f\n",min);
    printf("Shortest Path: ");
    for(int i=0;i<n;i++)
        printf("(%.0f, %.0f) -> ",p[best[i]].x,p[best[i]].y);
    printf("(%.0f, %.0f)\n",p[best[0]].x,p[best[0]].y);
}
int main() {
    Point test1[]={{1,2},{4,5},{7,1},{3,6}};
    Point test2[]={{2,4},{8,1},{1,7},{6,3},{5,9}};
    printf("Test Case 1:\n");
    solve(test1,4);
    printf("\nTest Case 2:\n");
    solve(test2,5);
    return 0;
}
