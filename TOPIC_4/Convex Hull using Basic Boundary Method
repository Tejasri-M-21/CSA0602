//Convex Hull using Basic Boundary Method
#include <stdio.h>
typedef struct {
    int x,y;
} Point;
int orientation(Point a,Point b,Point c) {
    int v=(b.y-a.y)*(c.x-b.x)-(b.x-a.x)*(c.y-b.y);
    if(v==0) return 0;
    return v>0?1:2;
}
int main() {
    Point p[]={{0,0},{1,1},{2,2},{0,2},{2,0}};
    int n=5,l=0,pnt,q;
    for(int i=1;i<n;i++)
        if(p[i].x<p[l].x) l=i;
    pnt=l;
    printf("Convex Hull Points:\n");
    do {
        printf("(%d,%d) ",p[pnt].x,p[pnt].y);
        q=(pnt+1)%n;
        for(int i=0;i<n;i++)
            if(orientation(p[pnt],p[i],p[q])==2)
                q=i;
        pnt=q;
    } while(pnt!=l);
    printf("\n");
    return 0;
}
