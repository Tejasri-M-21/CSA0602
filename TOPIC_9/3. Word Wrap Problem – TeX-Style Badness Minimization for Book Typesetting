//3. TeX-Style Badness Minimization for Book Typesetting
#include<stdio.h>
#include<limits.h>
int min_wrap_cost(int words[],int n,int width)
{
int dp[n+1],i,j,line_len,extra,cost;
dp[n]=0;
for(i=n-1;i>=0;i--)
{
dp[i]=INT_MAX;
line_len=0;
for(j=i;j<n;j++)
{
line_len+=words[j];
if(j>i)
line_len++;
if(line_len>width)
break;
extra=width-line_len;
cost=(j==n-1)?0:extra*extra;
if(dp[j+1]!=INT_MAX&&cost+dp[j+1]<dp[i])
dp[i]=cost+dp[j+1];
}
}
return dp[0];
}
int greedy_wrap_cost(int words[],int n,int width)
{
int i=0,line_len,cost=0,extra;
while(i<n)
{
line_len=words[i];
i++;
while(i<n&&line_len+1+words[i]<=width)
{
line_len+=1+words[i];
i++;
}
extra=width-line_len;
if(i<n)
cost+=extra*extra;
}
return cost;
}
int main()
{
int words[]={3,2,2,5};
int n=4,width=6;
int dp_cost=min_wrap_cost(words,n,width);
int greedy_cost=greedy_wrap_cost(words,n,width);
printf("DP Minimum Cost = %d\n",dp_cost);
printf("Greedy Wrap Cost = %d\n",greedy_cost);
if(dp_cost<=greedy_cost)
printf("DP gives optimal or equal cost\n");
printf("All test cases passed!");
return 0;
}
