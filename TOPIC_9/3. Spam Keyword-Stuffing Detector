//3. Spam Keyword-Stuffing Detector
#include<stdio.h>
#include<string.h>
#define MAX 100
#define INF 9999
int min(int a,int b)
{
return a<b?a:b;
}
int min_segments(char s[],char dict[][20],int count)
{
int n=strlen(s),i,j,k,len,found;
int dp[MAX+1];
for(i=0;i<=n;i++)
dp[i]=INF;
dp[0]=0;
for(i=1;i<=n;i++)
{
for(j=0;j<i;j++)
{
if(dp[j]==INF)
continue;
len=i-j;
found=0;
for(k=0;k<count;k++)
{
if(strlen(dict[k])==len&&strncmp(s+j,dict[k],len)==0)
{
found=1;
break;
}
}
if(found)
dp[i]=min(dp[i],dp[j]+1);
}
}
return dp[n]==INF?-1:dp[n];
}
int main()
{
char d1[][20]={"apple","pen"};
char d2[][20]={"cats","dog","sand","and","cat"};
printf("applepenapple = %d segments\n",min_segments("applepenapple",d1,2));
printf("catsandog = %d\n",min_segments("catsandog",d2,5));
printf("All test cases passed!");
return 0;
}
