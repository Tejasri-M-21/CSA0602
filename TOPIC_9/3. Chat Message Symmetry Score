//3. Chat Message Symmetry Score
#include<stdio.h>
#include<string.h>
#define MAX 100
int max(int a,int b)
{
return a>b?a:b;
}
float symmetry_ratio(char s[])
{
int n=strlen(s),i,j;
int dp[MAX][MAX];
if(n==0)
return 0;
for(i=0;i<n;i++)
dp[i][i]=1;
for(i=n-2;i>=0;i--)
{
for(j=i+1;j<n;j++)
{
if(s[i]==s[j])
dp[i][j]=dp[i+1][j-1]+2;
else
dp[i][j]=max(dp[i+1][j],dp[i][j-1]);
}
}
return (float)dp[0][n-1]/n;
}
int main()
{
char s1[]="bbbab";
char s2[]="cbbd";
printf("Symmetry Ratio of %s = %.2f\n",s1,symmetry_ratio(s1));
printf("Symmetry Ratio of %s = %.2f\n",s2,symmetry_ratio(s2));
printf("All test cases passed!");
return 0;
}
