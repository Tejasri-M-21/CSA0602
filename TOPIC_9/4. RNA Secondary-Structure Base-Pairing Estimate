//4. RNA Secondary-Structure Base-Pairing Estimate
#include<stdio.h>
#include<string.h>
#define MAX 100
int max(int a,int b)
{
return a>b?a:b;
}
int base_pair_estimate(char s[])
{
int n=strlen(s),i,j;
int prev[MAX],curr[MAX];
if(n==0)
return 0;
for(j=0;j<n;j++)
prev[j]=1;
for(i=n-2;i>=0;i--)
{
curr[i]=1;
for(j=i+1;j<n;j++)
{
if(s[i]==s[j])
curr[j]=prev[j-1]+2;
else
curr[j]=max(prev[j],curr[j-1]);
}
for(j=i;j<n;j++)
prev[j]=curr[j];
}
return prev[n-1]/2;
}
int main()
{
char s1[]="bbbab";
char s2[]="cbbd";
printf("Base Pair Estimate of %s = %d\n",s1,base_pair_estimate(s1));
printf("Base Pair Estimate of %s = %d\n",s2,base_pair_estimate(s2));
printf("All test cases passed!");
return 0;
}
