//10. Reconstructing Line Breaks for a Long Document
#include<stdio.h>
#define INF 999999
void wrap_lines(int words[],int n,int width)
{
int dp[100],choice[100],i,j,line_len,extra,cost;
dp[n]=0;
for(i=n-1;i>=0;i--)
{
dp[i]=INF;
choice[i]=i;
line_len=0;
for(j=i;j<n;j++)
{
line_len+=words[j];
if(j>i) line_len++;
if(line_len>width) break;
extra=width-line_len;
cost=(j==n-1)?0:extra*extra;
if(cost+dp[j+1]<dp[i])
{
dp[i]=cost+dp[j+1];
choice[i]=j+1;
}
}
}
printf("Minimum Wrap Cost = %d\n",dp[0]);
printf("Reconstructed Lines:\n");
i=0;
while(i<n)
{
printf("[");
for(j=i;j<choice[i];j++)
{
printf("%d",words[j]);
if(j<choice[i]-1) printf(", ");
}
printf("]\n");
i=choice[i];
}
}
int main()
{
int words[]={3,2,2,5};
int n=4,width=6;
wrap_lines(words,n,width);
printf("All test cases passed!\n");
return 0;
}
