//9. Log Sequence Symmetry Auditing
#include<stdio.h>
#include<string.h>
#define MAX 100
int max(int a,int b)
{
return a>b?a:b;
}
int lps_length(char s[])
{
int n=strlen(s),i,j;
int prev[MAX],curr[MAX];
if(n==0)
return 0;
for(j=0;j<n;j++)
prev[j]=1;
for(i=n-2;i>=0;i--)
{
curr[i]=1;
for(j=i+1;j<n;j++)
{
if(s[i]==s[j])
curr[j]=prev[j-1]+2;
else
curr[j]=max(prev[j],curr[j-1]);
}
for(j=i;j<n;j++)
prev[j]=curr[j];
}
return prev[n-1];
}
int main()
{
printf("LPS Length of bbbab = %d\n",lps_length("bbbab"));
printf("LPS Length of cbbd = %d\n",lps_length("cbbd"));
printf("All test cases passed!");
return 0;
}
