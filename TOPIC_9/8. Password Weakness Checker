//8. Password Weakness Checker
#include<stdio.h>
#include<string.h>
#define MAX 100
int max(int a,int b)
{
return a>b?a:b;
}
int is_weak_password(char s[],float threshold)
{
int n=strlen(s),i,j,lps;
int prev[MAX],curr[MAX];
if(n==0)
return 0;
for(j=0;j<n;j++)
prev[j]=1;
for(i=n-2;i>=0;i--)
{
curr[i]=1;
for(j=i+1;j<n;j++)
{
if(s[i]==s[j])
curr[j]=prev[j-1]+2;
else
curr[j]=max(prev[j],curr[j-1]);
}
for(j=i;j<n;j++)
prev[j]=curr[j];
}
lps=prev[n-1];
return ((float)lps/n)>threshold;
}
int main()
{
printf("bbbab Weak Password = %s\n",is_weak_password("bbbab",0.6)?"True":"False");
printf("cbbd Weak Password = %s\n",is_weak_password("cbbd",0.6)?"True":"False");
printf("All test cases passed!");
return 0;
}
