//10. Comparing LPS vs Longest Common Subsequence Reformulation
#include<stdio.h>
#include<string.h>
#define MAX 100
int max(int a,int b)
{
return a>b?a:b;
}
int lps_length(char s[])
{
int n=strlen(s),i,j;
int dp[MAX][MAX];
if(n==0)
return 0;
for(i=0;i<n;i++)
dp[i][i]=1;
for(i=n-2;i>=0;i--)
{
for(j=i+1;j<n;j++)
{
if(s[i]==s[j])
dp[i][j]=dp[i+1][j-1]+2;
else
dp[i][j]=max(dp[i+1][j],dp[i][j-1]);
}
}
return dp[0][n-1];
}
int lcs_length(char s1[],char s2[])
{
int n=strlen(s1),m=strlen(s2),i,j;
int dp[MAX+1][MAX+1];
for(i=0;i<=n;i++)
dp[i][0]=0;
for(j=0;j<=m;j++)
dp[0][j]=0;
for(i=1;i<=n;i++)
{
for(j=1;j<=m;j++)
{
if(s1[i-1]==s2[j-1])
dp[i][j]=dp[i-1][j-1]+1;
else
dp[i][j]=max(dp[i-1][j],dp[i][j-1]);
}
}
return dp[n][m];
}
void reverse_string(char s[],char rev[])
{
int n=strlen(s),i;
for(i=0;i<n;i++)
rev[i]=s[n-i-1];
rev[n]='\0';
}
int main()
{
char s1[]="bbbab",s2[]="cbbd";
char r1[MAX],r2[MAX];
int lps1,lcs1,lps2,lcs2;
reverse_string(s1,r1);
reverse_string(s2,r2);
lps1=lps_length(s1);
lcs1=lcs_length(s1,r1);
lps2=lps_length(s2);
lcs2=lcs_length(s2,r2);
printf("bbbab: LPS = %d, LCS with Reverse = %d\n",lps1,lcs1);
printf("cbbd: LPS = %d, LCS with Reverse = %d\n",lps2,lcs2);
if(lps1==lcs1&&lps2==lcs2)
printf("LPS equals LCS of the string and its reverse");
printf("\nAll test cases passed!");
return 0;
}
