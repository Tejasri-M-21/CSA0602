//8. Pruning Impossible Prefixes Before Full Enumeration
#include<stdio.h>
#include<string.h>
#define MAX 100
int can_segment(char s[],char dict[][20],int count)
{
int n=strlen(s),i,j,k,len,found;
int dp[MAX+1]={0};
dp[0]=1;
for(i=1;i<=n;i++)
{
for(j=0;j<i;j++)
{
if(!dp[j])
continue;
len=i-j;
for(k=0;k<count;k++)
{
if(strlen(dict[k])==len&&strncmp(s+j,dict[k],len)==0)
{
dp[i]=1;
break;
}
}
if(dp[i])
break;
}
}
return dp[n];
}
int main()
{
char d1[][20]={"cats","dog","sand","and","cat"};
char d2[][20]={"cats","cat","and","sand","dog"};
printf("catsandog = %s\n",can_segment("catsandog",d1,5)?"True":"False");
printf("catsanddog = %s\n",can_segment("catsanddog",d2,5)?"True":"False");
if(can_segment("catsanddog",d2,5))
printf("Proceed to full segmentation enumeration\n");
else
printf("Skip full enumeration\n");
printf("All test cases passed!");
return 0;
}
