// Question 8: Quick Sort Recursion Depth Analysis
#include <stdio.h>

int maxDepth = 0;

int partition(int a[], int low, int high) {
    int pivot = a[high], i = low - 1, temp;

    for (int j = low; j < high; j++) {
        if (a[j] <= pivot) {
            i++;
            temp = a[i];
            a[i] = a[j];
            a[j] = temp;
        }
    }

    temp = a[i + 1];
    a[i + 1] = a[high];
    a[high] = temp;

    return i + 1;
}

void quickSort(int a[], int low, int high, int depth) {
    if (depth > maxDepth)
        maxDepth = depth;

    if (low < high) {
        int p = partition(a, low, high);
        quickSort(a, low, p - 1, depth + 1);
        quickSort(a, p + 1, high, depth + 1);
    }
}

int main() {
    int n, a[100];

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    quickSort(a, 0, n - 1, 1);

    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\nMax Depth : %d", maxDepth);

    return 0;
}
