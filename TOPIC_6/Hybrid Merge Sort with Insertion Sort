#include <stdio.h>

#define THRESHOLD 4

void insertionSort(int a[], int low, int high) {
    int i, j, key;

    for (i = low + 1; i <= high; i++) {
        key = a[i];
        j = i - 1;

        while (j >= low && a[j] > key) {
            a[j + 1] = a[j];
            j--;
        }

        a[j + 1] = key;
    }
}

void merge(int a[], int low, int mid, int high) {
    int temp[100];
    int i = low, j = mid + 1, k = 0;

    while (i <= mid && j <= high) {
        if (a[i] <= a[j])
            temp[k++] = a[i++];
        else
            temp[k++] = a[j++];
    }

    while (i <= mid)
        temp[k++] = a[i++];

    while (j <= high)
        temp[k++] = a[j++];

    for (i = low, k = 0; i <= high; i++, k++)
        a[i] = temp[k];
}

void hybridMergeSort(int a[], int low, int high) {
    int mid;

    if (high - low + 1 <= THRESHOLD) {
        insertionSort(a, low, high);
        return;
    }

    mid = (low + high) / 2;

    hybridMergeSort(a, low, mid);
    hybridMergeSort(a, mid + 1, high);
    merge(a, low, mid, high);
}

int main() {
    int n, a[100];

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    hybridMergeSort(a, 0, n - 1);

    for (int i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}
