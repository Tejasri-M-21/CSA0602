#include <stdio.h>
#include <string.h>

struct Job {
    char id[3];
    int deadline;
    int profit;
};

int main() {
    struct Job jobs[] = {
        {"P1", 1, 40},
        {"P2", 1, 30},
        {"P3", 2, 20},
        {"P4", 2, 10}
    };

    int n = 4;
    int slot[3] = {0};
    int maxProfit = 0;

    // Sort jobs by profit in descending order
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (jobs[i].profit < jobs[j].profit) {
                struct Job temp = jobs[i];
                jobs[i] = jobs[j];
                jobs[j] = temp;
            }
        }
    }

    printf("Selected jobs = ");

    // Schedule each job in the latest available slot
    for (int i = 0; i < n; i++) {
        for (int j = jobs[i].deadline; j >= 1; j--) {
            if (slot[j] == 0) {
                slot[j] = 1;
                printf("%s ", jobs[i].id);
                maxProfit += jobs[i].profit;
                break;
            }
        }
    }

    printf("\nMaximum profit = %d\n", maxProfit);

    return 0;
}
