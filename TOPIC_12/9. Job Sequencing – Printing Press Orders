#include <stdio.h>

struct Job {
    char id;
    int deadline;
    int profit;
};

int main() {
    struct Job jobs[] = {
        {'A', 2, 100},
        {'B', 1, 50},
        {'C', 2, 10},
        {'D', 1, 20},
        {'E', 3, 30}
    };

    int n = 5;
    int slot[4] = {0};
    int maxProfit = 0;

    // Sort jobs by profit in descending order
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (jobs[i].profit < jobs[j].profit) {
                struct Job temp = jobs[i];
                jobs[i] = jobs[j];
                jobs[j] = temp;
            }
        }
    }

    printf("Selected jobs = ");

    // Schedule jobs in the latest available slot
    for (int i = 0; i < n; i++) {
        for (int j = jobs[i].deadline; j >= 1; j--) {
            if (slot[j] == 0) {
                slot[j] = 1;
                printf("%c ", jobs[i].id);
                maxProfit += jobs[i].profit;
                break;
            }
        }
    }

    printf("\nMaximum profit = %d\n", maxProfit);

    return 0;
}
