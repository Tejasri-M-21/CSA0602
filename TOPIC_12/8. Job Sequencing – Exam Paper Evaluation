#include <stdio.h>

struct Job {
    char id[3];
    int deadline;
    int profit;
};

int main() {
    struct Job jobs[] = {
        {"J1", 2, 20},
        {"J2", 1, 15},
        {"J3", 2, 10},
        {"J4", 1, 5},
        {"J5", 3, 1}
    };

    int n = 5;
    int slot[4] = {0};
    int maxProfit = 0;

    // Sort jobs by profit in descending order
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (jobs[i].profit < jobs[j].profit) {
                struct Job temp = jobs[i];
                jobs[i] = jobs[j];
                jobs[j] = temp;
            }
        }
    }

    printf("Selected jobs = ");

    // Schedule jobs in the latest available slot
    for (int i = 0; i < n; i++) {
        for (int j = jobs[i].deadline; j >= 1; j--) {
            if (slot[j] == 0) {
                slot[j] = 1;
                printf("%s ", jobs[i].id);
                maxProfit += jobs[i].profit;
                break;
            }
        }
    }

    printf("\nMaximum profit = %d\n", maxProfit);

    return 0;
}
