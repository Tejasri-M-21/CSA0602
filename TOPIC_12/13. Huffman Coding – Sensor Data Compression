#include <stdio.h>
#include <stdlib.h>

struct Node {
    char data;
    int freq;
    struct Node *left;
    struct Node *right;
};

// Create a new node
struct Node* createNode(char data, int freq) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));

    node->data = data;
    node->freq = freq;
    node->left = NULL;
    node->right = NULL;

    return node;
}

// Swap two nodes
void swap(struct Node** a, struct Node** b) {
    struct Node* temp = *a;
    *a = *b;
    *b = temp;
}

// Sort nodes by frequency
void sortNodes(struct Node* nodes[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (nodes[i]->freq > nodes[j]->freq) {
                swap(&nodes[i], &nodes[j]);
            }
        }
    }
}

// Generate Huffman codes
void generateCodes(struct Node* root, int code[], int top) {

    if (root->left) {
        code[top] = 0;
        generateCodes(root->left, code, top + 1);
    }

    if (root->right) {
        code[top] = 1;
        generateCodes(root->right, code, top + 1);
    }

    // Leaf node
    if (!root->left && !root->right) {
        printf("%c: ", root->data);

        for (int i = 0; i < top; i++) {
            printf("%d", code[i]);
        }

        printf("\n");
    }
}

int main() {
    char characters[] = {'x', 'y', 'z', 'w'};
    int frequencies[] = {7, 8, 14, 25};

    int n = 4;

    struct Node* nodes[10];

    // Create nodes
    for (int i = 0; i < n; i++) {
        nodes[i] = createNode(characters[i], frequencies[i]);
    }

    int size = n;

    // Build Huffman Tree
    while (size > 1) {

        // Sort nodes by frequency
        sortNodes(nodes, size);

        // Select two smallest nodes
        struct Node* left = nodes[0];
        struct Node* right = nodes[1];

        // Create combined node
        struct Node* newNode =
            createNode('$', left->freq + right->freq);

        newNode->left = left;
        newNode->right = right;

        // Remove two smallest nodes
        for (int i = 2; i < size; i++) {
            nodes[i - 2] = nodes[i];
        }

        // Add combined node
        nodes[size - 2] = newNode;

        size--;
    }

    int code[20];

    printf("Huffman Codes:\n");

    generateCodes(nodes[0], code, 0);

    return 0;
}
