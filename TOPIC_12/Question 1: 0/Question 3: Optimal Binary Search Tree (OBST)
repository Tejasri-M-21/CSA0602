# 3. Optimal Binary Search Tree (OBST)

def optimal_bst(keys, freq):

    n = len(keys)

    # Create cost table
    cost = [[0 for _ in range(n)] for _ in range(n)]

    # Cost of a single key
    for i in range(n):
        cost[i][i] = freq[i]

    # Consider chains of different lengths
    for length in range(2, n + 1):

        for i in range(n - length + 1):

            j = i + length - 1

            cost[i][j] = float('inf')

            # Calculate total frequency
            total_freq = sum(freq[i:j + 1])

            # Try every key as root
            for r in range(i, j + 1):

                left = cost[i][r - 1] if r > i else 0

                right = cost[r + 1][j] if r < j else 0

                cost[i][j] = min(
                    cost[i][j],
                    left + right + total_freq
                )

    return cost[0][n - 1]


# Input
keys = [10, 20, 30]
freq = [34, 8, 50]

# Calculate optimal BST cost
result = optimal_bst(keys, freq)

print("Optimal BST Cost:", result)
