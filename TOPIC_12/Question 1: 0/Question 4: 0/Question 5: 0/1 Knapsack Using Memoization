# 5. 0/1 Knapsack Using Memoization

def knapsack(W, wt, val, n, memo):

    # Base case
    if n == 0 or W == 0:
        return 0

    # Return already calculated result
    if memo[n][W] != -1:
        return memo[n][W]

    # If current item can be included
    if wt[n - 1] <= W:

        memo[n][W] = max(
            val[n - 1] +
            knapsack(
                W - wt[n - 1],
                wt,
                val,
                n - 1,
                memo
            ),

            knapsack(
                W,
                wt,
                val,
                n - 1,
                memo
            )
        )

    # If current item cannot be included
    else:

        memo[n][W] = knapsack(
            W,
            wt,
            val,
            n - 1,
            memo
        )

    return memo[n][W]


# Input
wt = [1, 3, 4, 5]
val = [1, 4, 5, 7]
W = 7

# Create memoization table
memo = [
    [-1] * (W + 1)
    for _ in range(len(wt) + 1)
]

# Calculate maximum profit
result = knapsack(
    W,
    wt,
    val,
    len(wt),
    memo
)

print("Maximum Profit =", result)
