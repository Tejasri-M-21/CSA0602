#include <stdio.h>

int main() {
    int coins[] = {5, 2, 1};
    int n = 3;
    int amount = 11;
    int count = 0;

    printf("Coins used: ");

    // Greedy approach: select the largest possible coin
    for (int i = 0; i < n; i++) {
        while (amount >= coins[i]) {
            printf("%d ", coins[i]);
            amount -= coins[i];
            count++;
        }
    }

    printf("\nMinimum coins = %d\n", count);

    return 0;
}
