//Complete Brute Force String Matching and Complexity Analysis
#include <stdio.h>
#include <string.h>
int main() {
    char text[] = "TTATAGATCTCGTATTCTTTATAGATCTCCTATTCTT";
    char pattern[] = "TATCTT";
    int n = strlen(text);
    int m = strlen(pattern);
    int i, j, comparisons = 0, found = 0;
    printf("Shifting Process:\n");
    for (i = 0; i <= n - m; i++) {
        printf("Shift %d: ", i);
        for (j = 0; j < m; j++) {
            comparisons++;
            if (text[i + j] != pattern[j]) {
                printf("Mismatch\n");
                break;
            }
        }
        if (j == m) {
            printf("Match\n");
            printf("Pattern occurrence at position %d\n", i);
            found = 1;
        }
    }
    if (!found)
        printf("Pattern not found\n");
    printf("\nTotal comparisons = %d\n", comparisons);
    printf("\nComplexity Analysis:\n");
    printf("Best Case Complexity = O(n)\n");
    printf("Worst Case Complexity = O(n*m)\n");
    printf("Space Complexity = O(1)\n");
    return 0;
}
