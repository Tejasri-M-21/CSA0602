//All Occurrences Using Sequential Search
#include <stdio.h>
int main() {
    int arr[] = {7, 12, 7, 25, 18, 7, 30, 7};
    int n = 8, key = 7;
    int i, count = 0;
    printf("Occurrences at positions:\n");
    for (i = 0; i < n; i++) {
        if (arr[i] == key) {
            if (count > 0)
                printf(", ");
            printf("%d", i + 1);
            count++;
        }
    }
    if (count == 0)
        printf("None");
    printf("\nTotal occurrences = %d\n", count);
    return 0;
}
