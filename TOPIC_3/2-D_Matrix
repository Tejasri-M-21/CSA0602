//Sequential Search in a 2-D Matrix
#include <stdio.h>
int main() {
    int matrix[3][3] = {
        {12, 8, 15},
        {5, 18, 27},
        {9, 11, 24}
    };
    int key = 24;
    int i, j, found = 0;
    for (i = 0; i < 3; i++) {
        for (j = 0; j < 3; j++) {
            if (matrix[i][j] == key) {
                printf("Element found at Row %d Column %d\n", i + 1, j + 1);
                found = 1;
                break;
            }
        }
        if (found)
            break;
    }
    if (!found)
        printf("Element not found\n");
    return 0;
}
