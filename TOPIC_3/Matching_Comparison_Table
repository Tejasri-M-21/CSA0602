//Brute Force String Matching Comparison Table
#include <stdio.h>
#include <string.h>
int main() {
    char text[] = "MISSISSIPPI";
    char pattern[] = "ISSI";
    int n = strlen(text);
    int m = strlen(pattern);
    int i, j, comparisons;
    for (i = 0; i <= n - m; i++) {
        comparisons = 0;
        printf("Shift %d: ", i);
        for (j = 0; j < m; j++) {
            comparisons++;
            if (text[i + j] != pattern[j]) {
                printf("Mismatch at comparison %d", comparisons);
                break;
            }
        }
        if (j == m)
            printf("Match");
        printf(" | Comparisons = %d\n", comparisons);
    }
    return 0;
}
