//Sequential Search on Student Register Numbers
#include <stdio.h>
int main() {
    int reg[] = {101, 102, 103, 104, 105, 106};
    int n = 6, key = 104;
    int i, found = 0;
    for (i = 0; i < n; i++) {
        if (reg[i] == key) {
            printf("Register Number found at position %d\n", i + 1);
            found = 1;
            break;
        }
    }
    if (!found)
        printf("Register Number not found\n");
    return 0;
}
