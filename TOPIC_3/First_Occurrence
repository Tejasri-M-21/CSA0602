//First Occurrence Using Sequential Search
#include <stdio.h>
int main() {
    int arr[] = {10, 25, 15, 25, 30, 25, 40};
    int n = 7, key = 25;
    int i, found = 0;
    for (i = 0; i < n; i++) {
        if (arr[i] == key) {
            printf("First occurrence at position %d\n", i + 1);
            found = 1;
            break;
        }
    }
    if (!found) {
        printf("Element not found\n");
    }
    return 0;
}
