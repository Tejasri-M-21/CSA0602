#include <stdio.h>

void findMinMax(int a[], int low, int high, int *min, int *max) {
    int mid, min1, max1, min2, max2;

    if (low == high) {
        *min = *max = a[low];
        return;
    }

    mid = (low + high) / 2;

    findMinMax(a, low, mid, &min1, &max1);
    findMinMax(a, mid + 1, high, &min2, &max2);

    *min = (min1 < min2) ? min1 : min2;
    *max = (max1 > max2) ? max1 : max2;
}

int main() {
    int n, a[100], min, max;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    findMinMax(a, 0, n - 1, &min, &max);

    printf("Minimum Stock Price = %d\n", min);
    printf("Maximum Stock Price = %d", max);

    return 0;
}
