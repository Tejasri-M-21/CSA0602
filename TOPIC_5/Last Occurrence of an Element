#include <stdio.h>

int main() {
    int n, a[100], key, low, high, mid, index = -1;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while (low <= high) {
        mid = (low + high) / 2;

        if (a[mid] == key) {
            index = mid;
            low = mid + 1;
        }
        else if (a[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if (index != -1)
        printf("Last occurrence at index %d", index);
    else
        printf("Element not found");

    return 0;
}
