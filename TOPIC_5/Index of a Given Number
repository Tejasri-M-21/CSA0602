#include <stdio.h>

int main() {
    int n, a[100], target, low, high, mid, index = -1;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &target);

    low = 0;
    high = n - 1;

    while (low <= high) {
        mid = (low + high) / 2;

        if (a[mid] == target) {
            index = mid;
            break;
        }
        else if (a[mid] < target)
            low = mid + 1;
        else
            high = mid - 1;
    }

    printf("Index = %d", index);

    return 0;
}
