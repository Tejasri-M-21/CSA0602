#include <stdio.h>

int main() {
    int n, a[100], key, low, high, mid, iterations = 0, found = 0;

    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while (low <= high) {
        iterations++;
        mid = (low + high) / 2;

        if (a[mid] == key) {
            found = 1;
            break;
        }
        else if (a[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if (found)
        printf("Element found\n");
    else
        printf("Element not found\n");

    printf("Iterations = %d", iterations);

    return 0;
}
